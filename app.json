{
  "expo": {
    "name": "FitMap",
    "slug": "fitmap-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitmap",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitmap.app"
    },
    "android": {
      "package": "com.fitmap.app",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}